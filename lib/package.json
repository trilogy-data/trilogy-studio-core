{
  "name": "@trilogy-data/trilogy-studio-components",
  "version": "0.1.27",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "style": "dist/trilogy-studio-components.css",
  "exports": {
    "./dashboard": {
      "types": "./dist/dashboard.d.ts",
      "import": "./dist/dashboard.js",
      "default": "./dist/dashboard.js"
    },
    "./views": {
      "types": "./dist/views.d.ts",
      "import": "./dist/views.js",
      "default": "./dist/views.js"
    },
    "./monaco": {
      "types": "./dist/monaco.d.ts",
      "import": "./dist/monaco.js",
      "default": "./dist/monaco.js"
    },
    "./llm": {
      "types": "./dist/llm.d.ts",
      "import": "./dist/llm.js",
      "default": "./dist/llm.js"
    },
    "./stores": {
      "types": "./dist/stores.d.ts",
      "import": "./dist/stores.js",
      "default": "./dist/stores.js"
    },
    "./connections": {
      "types": "./dist/connections.d.ts",
      "import": "./dist/connections.js",
      "default": "./dist/connections.js"
    },
    "./embed": {
      "types": "./dist/embed.d.ts",
      "import": "./dist/embed.js",
      "default": "./dist/embed.js"
    },
    "./style.css": "./dist/trilogy-studio-components.css"
  },
  "repository": {
    "url": "https://github.com/trilogy-data/trilogy-studio-core"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm build:grammar && pnpm sync:trilogy-ai && vite build",
    "build:grammar": "pnpm -C ../prism-trilogy install --frozen-lockfile && pnpm -C ../prism-trilogy build",
    "sync:trilogy-ai": "node ../scripts/generate-trilogy-ai-guidance.mjs",
    "check:trilogy-ai": "node ../scripts/generate-trilogy-ai-guidance.mjs --check",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest"
  },
  "peerDependencies": {
    "pinia": "^2.0.0 || ^3.0.0 || ^4.0.0",
    "prismjs": "^1.30.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@trilogy-data/prism-trilogy": "link:../prism-trilogy",
    "@types/luxon": "^3.7.5",
    "@types/prismjs": "^1.26.6",
    "@types/tabulator-tables": "^6.3.6",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/ui": "^4.1.11",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^29.1.1",
    "pinia": "^4.0.3",
    "prettier": "^3.9.9",
    "prismjs": "^1.30.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.1",
    "vite-plugin-dts": "^5.1.1",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^4.1.11",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.32.0",
    "@google/genai": "^2.24.0",
    "@mdi/js": "^7.4.47",
    "@motherduck/wasm-client": "^0.8.1",
    "apache-arrow": "^21.2.0",
    "dompurify": "^3.4.16",
    "jose": "^6.2.12",
    "luxon": "^3.7.2",
    "modern-screenshot": "4.7.0",
    "monaco-editor": "^0.55.1",
    "split.js": "^1.6.5",
    "sql.js": "^1.14.2",
    "tabulator-tables": "^6.5.3",
    "vega": "^6.4.0",
    "vega-embed": "^7.3.0",
    "vega-lite": "^6.4.3",
    "vue3-grid-layout-next": "^1.0.7"
  },
  "pnpm": {
    "overrides": {
      "monaco-editor>dompurify": "^3.4.16",
      "lodash": "^4.18.0",
      "minimatch@>=10.0.0 <10.2.3": "^10.2.3",
      "ajv@>=7.0.0 <8.18.0": "^8.18.0",
      "rollup@>=4.0.0 <4.59.0": "^4.59.0"
    }
  }
}
