{
  "name": "trilogy-studio-app",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "prepublishOnly": "pnpm build",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "pnpm install ./lib -D && vite",
    "local": "node scripts/run_local.js",
    "build": "pnpm build:grammar && pnpm sync:trilogy-ai && vue-tsc -b && pnpm format && vite build",
    "build:frontend": "pnpm build:grammar && vue-tsc -b && vite build",
    "build:lib": "pnpm -C lib build",
    "build:grammar": "pnpm -C prism-trilogy install --frozen-lockfile && pnpm -C prism-trilogy build",
    "sync:trilogy-ai": "node scripts/generate-trilogy-ai-guidance.mjs",
    "check:trilogy-ai": "node scripts/generate-trilogy-ai-guidance.mjs --check",
    "check:trilogy-vocabulary": "node scripts/check-trilogy-vocabulary.mjs --check",
    "preview": "vite preview",
    "test": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "test-playwright": "playwright test",
    "test-playwright:ui": "playwright test --ui",
    "format": "prettier --write \"{lib,src,e2e,explorer/src,scripts,docker}/**/*.{js,mjs,ts,vue}\" \"*.{js,mjs,ts}\" \"explorer/*.{js,mjs,ts,vue}\"",
    "benchmark-llm": "npx ts-node scripts/benchmark-llm.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@trilogy-data/prism-trilogy": "link:prism-trilogy",
    "@trilogy-data/trilogy-studio-components": "link:lib",
    "@types/gapi": "^0.0.47",
    "@types/luxon": "^3.7.5",
    "@types/node": "^26.6.3",
    "@types/prismjs": "^1.26.6",
    "@types/tabulator-tables": "^6.3.6",
    "@types/webappsec-credential-management": "^0.6.9",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/ui": "^4.1.11",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "rollup-plugin-visualizer": "^7.1.1",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "vite": "^8.3.1",
    "vite-plugin-dts": "^5.1.1",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11",
    "yargs": "^18.2.0"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.32.0",
    "@fontsource/inter": "^5.3.0",
    "@google/genai": "^2.24.0",
    "@mdi/js": "^7.4.47",
    "@motherduck/wasm-client": "^0.8.1",
    "apache-arrow": "^21.2.0",
    "dompurify": "^3.4.16",
    "dotenv": "^17.4.2",
    "jose": "^6.2.12",
    "luxon": "^3.7.2",
    "modern-screenshot": "4.7.0",
    "monaco-editor": "^0.55.1",
    "pinia": "^4.0.3",
    "prismjs": "^1.30.0",
    "split.js": "^1.6.5",
    "sql.js": "^1.14.2",
    "tabulator-tables": "^6.5.3",
    "vega": "^6.4.0",
    "vega-embed": "^7.3.0",
    "vega-lite": "^6.4.3",
    "vite-plugin-prismjs": "^0.0.11",
    "vue": "3.5.43",
    "vue3-grid-layout-next": "^1.0.7"
  },
  "pnpm": {
    "overrides": {
      "monaco-editor>dompurify": "^3.4.16",
      "lodash": "^4.18.0",
      "minimatch@>=10.0.0 <10.2.3": "^10.2.3",
      "ajv@>=7.0.0 <8.18.0": "^8.18.0",
      "rollup@>=4.0.0 <4.59.0": "^4.59.0"
    }
  }
}
